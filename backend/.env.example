# Copy this file to ".env" and replace the placeholder values.
# NEVER commit your real .env file.

# Neon PostgreSQL connection string (from the Neon dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Long random string used to sign login tokens (at least 16 characters)
JWT_SECRET="replace-with-a-long-random-secret"

# Port the API listens on
PORT=5000

# Google Gemini API key (used from Phase 3, BACKEND ONLY - never put this in the frontend)
GEMINI_API_KEY="replace-with-your-gemini-api-key"

# Optional Gemini settings (defaults shown). Without a key the app still runs and
# the AI triage automatically falls back to safe general guidance.
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_TIMEOUT_MS=12000

# Optional settings (defaults shown)
# NODE_ENV=development
# JWT_EXPIRES_IN=7d
# CLIENT_URL=http://localhost:5173
