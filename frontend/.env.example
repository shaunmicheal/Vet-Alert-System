# API origin. The Axios client appends /api automatically, because the backend
# mounts every route under /api (e.g. /api/auth/register).
VITE_API_URL=http://localhost:5000

# Public UI-only flag for the veterinary demonstration experience.
# - "true" (default when unset): directory cards, referral flows and admin
#   oversight label seeded fictional profiles as demonstration profiles and
#   explain that no real professional is contacted.
# - "false": hide that labelling once real, verified professionals are listed.
# This flag only controls copy and badges. It never controls authentication,
# role guards, referral ownership checks, or any server-side security.
VITE_VET_DEMO_MODE=true
